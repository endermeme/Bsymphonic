<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>jsymphonic</groupId>
	<artifactId>jsymphonic</artifactId>
	<version>0.5.3</version>
	<packaging>jar</packaging>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
    	<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<archive>
								<manifest>
									<mainClass>
										org.danizmax.jsymphonic.gui.JSymphonic
									</mainClass>
								</manifest>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>prepare-windows-portable</id>
						<phase>package</phase>
						<configuration>
							<target>
								<mkdir dir="${project.build.directory}/windows-portable" />
								<copy
									file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
									tofile="${project.build.directory}/windows-portable/jsymphonic.jar" />
								<copy
									file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
									tofile="${project.basedir}/jsymphonic.jar" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
					<execution>
						<id>cleanup-launch4j-input</id>
						<phase>verify</phase>
						<configuration>
							<target>
								<delete file="${project.basedir}/jsymphonic.jar" failonerror="false" />
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.akathist.maven.plugins.launch4j</groupId>
				<artifactId>launch4j-maven-plugin</artifactId>
				<version>1.7.25</version>
				<executions>
					<execution>
						<id>windows-wrapper</id>
						<phase>package</phase>
						<goals>
							<goal>launch4j</goal>
						</goals>
						<configuration>
							<headerType>gui</headerType>
							<outfile>${project.build.directory}/windows-portable/BinhTagilla-JSymphonic.exe</outfile>
							<jar>jsymphonic.jar</jar>
							<icon>${project.basedir}/build-resources/windows/app-icon.ico</icon>
							<errTitle>Binh Tagilla JSymphonic Revival</errTitle>
							<classPath>
								<mainClass>org.danizmax.jsymphonic.gui.JSymphonic</mainClass>
							</classPath>
							<jre>
								<path>jre</path>
								<bundledJre64Bit>false</bundledJre64Bit>
								<bundledJreAsFallback>false</bundledJreAsFallback>
								<minVersion>1.8.0</minVersion>
								<maxVersion>1.8.999</maxVersion>
							</jre>
							<versionInfo>
								<fileVersion>0.5.3.0</fileVersion>
								<txtFileVersion>0.5.3</txtFileVersion>
								<fileDescription>Binh Tagilla JSymphonic Revival</fileDescription>
								<copyright>Original authors and revival contributors</copyright>
								<productVersion>0.5.3.0</productVersion>
								<txtProductVersion>0.5.3</txtProductVersion>
								<productName>Binh Tagilla JSymphonic Revival</productName>
								<companyName>Binh Tagilla</companyName>
								<internalName>BinhTagilla-JSymphonic</internalName>
								<originalFilename>BinhTagilla-JSymphonic.exe</originalFilename>
							</versionInfo>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
		    <groupId>org.swinglabs</groupId>
		    <artifactId>swing-layout</artifactId>
		    <version>1.0.3</version>
		</dependency>
		<dependency>
			<groupId>org</groupId>
			<artifactId>jaudiotagger</artifactId>
			<version>2.0.3</version>
		</dependency>
		<dependency>
      		<groupId>net.samuelcampos</groupId>
      		<artifactId>usbdrivedetector</artifactId>
      		<version>2.2.1</version>
    	</dependency>
	</dependencies>
</project>
